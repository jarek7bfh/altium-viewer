{
  "name": "Altium Viewer",
  "short_name": "Altium Viewer",
  "description": "Przeglądarka schematów i PCB Altium z cross-selection",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1217",
  "theme_color": "#0f1217",
  "lang": "pl",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["*/*", ".PrjPcb", ".SchDoc", ".PcbDoc", "application/octet-stream"] }
      ]
    }
  }
}
